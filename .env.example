# ═══════════════════════════════════════════════════════════════════════════
# PROJECT PHOENIX OS — environment variables.  Copy to .env.local and fill in.
# Only the first block is required. Everything else is an optional upgrade.
# NEXT_PUBLIC_* values are baked into the browser bundle at BUILD time, so set them
# before `next build` (on Vercel: add them in Project Settings → Environment Variables).
# ═══════════════════════════════════════════════════════════════════════════

# ── REQUIRED: Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "anon" JWT key or the newer "publishable" key: both work.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Lets the API pay out XP/Gold (game state is server-authoritative). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# Public URL of the app (used for metadata/links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Which OAuth buttons to show on the login/sign-up pages. Each must also be enabled in Supabase → Authentication → Providers.
# Options: google, github, apple. Use an empty value for email-only.
NEXT_PUBLIC_AUTH_PROVIDERS=google,github

# ── OPTIONAL: AI Dungeon Master ("hybrid"): leave ALL of these blank to run on the built-in offline engine ──
# With a key set, the Dungeon Master upgrades automatically (priority: Anthropic → OpenAI → Gemini).
# If an AI call ever fails (bad key, rate limit, timeout, malformed output) the offline engine takes over silently.
# DM_PROVIDER forces a choice: offline | anthropic | openai | gemini | ollama
DM_PROVIDER=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Point at any OpenAI-compatible server (vLLM, LM Studio, OpenRouter…). Leave blank for api.openai.com.
OPENAI_BASE_URL=
OPENAI_REASONING_EFFORT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=

# Local development with Ollama (never auto-selected; set DM_PROVIDER=ollama).  `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ── OPTIONAL: scheduled jobs (/api/cron/morning, /api/cron/evening) ─────────
# Any long random string: `openssl rand -hex 32`. Vercel Cron sends it automatically as "Authorization: Bearer <secret>".
# Without it the endpoints refuse every request. The app still works: quests are also generated lazily when a player opens it.
CRON_SECRET=

# ── OPTIONAL: web push (OneSignal) ──────────────────────────────────────────
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# ── OPTIONAL: product analytics (PostHog). Respects Do-Not-Track, no session recording, never sends task text ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── OPTIONAL: error monitoring (Sentry). Without a DSN the SDK is disabled and sends nothing ──
NEXT_PUBLIC_SENTRY_DSN=
# Only needed at build time if you want readable stack traces (source-map upload):
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
